# Server-side configuration for local development.
# Copy to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public/publishable key used by the browser for signed uploads.
# The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Must never carry the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Gemini credential.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Primary model; defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
# Optional. Failover model used when the primary fails; defaults to gemini-3.7-flash.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Server-only HMAC secret for admin sessions and media proofs; 32+ random characters.
CITYAI_SERVER_SECRET=replace-with-32-plus-random-characters
# Operator password; 12-256 characters.
CITYAI_ADMIN_PASSWORD=replace-with-strong-password
